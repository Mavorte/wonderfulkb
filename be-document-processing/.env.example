# Configure your AWS SSO profile in the shell; do not put credentials in Git.
AWS_PROFILE=ai-hackathon
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
OCR_PROVIDER=bedrock
BEDROCK_API=mantle
BEDROCK_REGION=eu-central-1
BEDROCK_OCR_MODEL=qwen.qwen3-vl-235b-a22b-instruct
BEDROCK_EXTRACTION_MODEL=qwen.qwen3-vl-235b-a22b-instruct
STORAGE_BACKEND=local
DATA_DIR=.local-data
PUBLIC_URL=http://127.0.0.1:8010
# The /v1 API fails closed: set DOCUMENT_API_KEY (clients send x-api-key),
# or opt in explicitly to running without a key for local development only.
# DOCUMENT_API_KEY=
DOCUMENT_API_ALLOW_NO_AUTH=1

# Optional audit store; empty disables it without initializing AWS.
# SDK connect/read timeouts: 1s/2s, one total attempt (no audit retries).
AUDIT_TABLE_NAME=

# Alternative vision model, same region, using the /openai/v1 Mantle route.
# BEDROCK_OCR_MODEL=google.gemma-4-31b
# BEDROCK_EXTRACTION_MODEL=google.gemma-4-31b
