{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "type": {
          "default": "paragraph",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bbox"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "block_id",
        "text",
        "bbox"
      ],
      "title": "Block",
      "type": "object"
    },
    "Cell": {
      "additionalProperties": false,
      "properties": {
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "row_span": {
          "default": 1,
          "minimum": 1,
          "title": "Row Span",
          "type": "integer"
        },
        "column_span": {
          "default": 1,
          "minimum": 1,
          "title": "Column Span",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "row",
        "column",
        "text"
      ],
      "title": "Cell",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "page_number",
        "block_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExtractedField": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "key": {
          "enum": [
            "entity.name",
            "entity.ico",
            "entity.dic",
            "entity.address",
            "contract.number",
            "invoice.number",
            "order.number",
            "asset.name",
            "asset.serial",
            "asset.year",
            "asset.condition",
            "purchase.net",
            "purchase.vat",
            "purchase.gross",
            "loan.principal",
            "loan.annual_rate",
            "loan.term_months",
            "loan.own_funds",
            "loan.total",
            "payment.amount",
            "payment.account",
            "payment.frequency",
            "installment.amount",
            "installment.count",
            "date.issued",
            "date.signed",
            "date.due",
            "date.handover"
          ],
          "title": "Key",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "provider",
                "borrower",
                "buyer",
                "supplier",
                "guarantor",
                "insurer",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Value"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized Value"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "status": {
          "enum": [
            "extracted",
            "not_found",
            "unreadable",
            "ambiguous",
            "human_corrected"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "original_normalized_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Normalized Value"
        },
        "correction_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correction Id"
        }
      },
      "required": [
        "field_id",
        "key",
        "role",
        "raw_value",
        "normalized_value",
        "status",
        "evidence"
      ],
      "title": "ExtractedField",
      "type": "object"
    },
    "ExtractionResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "loan_agreement",
            "invoice",
            "order",
            "handover",
            "repayment_schedule",
            "security_transfer",
            "guarantee",
            "insurance",
            "payment_confirmation",
            "terms",
            "technical_specification",
            "other",
            "unknown"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ExtractedField"
          },
          "title": "Fields",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "schema_version",
        "document_type",
        "fields",
        "warnings",
        "model"
      ],
      "title": "ExtractionResult",
      "type": "object"
    },
    "OcrResult": {
      "additionalProperties": false,
      "properties": {
        "pages": {
          "items": {
            "$ref": "#/$defs/Page"
          },
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "pages"
      ],
      "title": "OcrResult",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "method": {
          "enum": [
            "vision",
            "native"
          ],
          "title": "Method",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "markdown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/Table"
          },
          "title": "Tables",
          "type": "array"
        },
        "visual_marks": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Visual Marks",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "page_number",
        "status",
        "method",
        "width",
        "height",
        "text"
      ],
      "title": "Page",
      "type": "object"
    },
    "SignatureItem": {
      "additionalProperties": false,
      "properties": {
        "signature_id": {
          "title": "Signature Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "detector": {
          "const": "textract",
          "default": "textract",
          "title": "Detector",
          "type": "string"
        },
        "detection_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Score"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "provider",
                "borrower",
                "buyer",
                "supplier",
                "guarantor",
                "insurer",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "role_source": {
          "anyOf": [
            {
              "enum": [
                "nearest_text",
                "ocr_blocks"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Source"
        },
        "role_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Evidence"
        },
        "nearby_text": {
          "items": {
            "type": "string"
          },
          "title": "Nearby Text",
          "type": "array"
        }
      },
      "required": [
        "signature_id",
        "page",
        "bbox"
      ],
      "title": "SignatureItem",
      "type": "object"
    },
    "SignatureSection": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "detector": {
          "const": "textract",
          "default": "textract",
          "title": "Detector",
          "type": "string"
        },
        "signatures": {
          "items": {
            "$ref": "#/$defs/SignatureItem"
          },
          "title": "Signatures",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "status"
      ],
      "title": "SignatureSection",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "html": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "table_id"
      ],
      "title": "Table",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "title": "Case Id",
      "type": "string"
    },
    "client_id": {
      "title": "Client Id",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "page_count": {
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "processing_status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "Processing Status",
      "type": "string"
    },
    "ocr": {
      "$ref": "#/$defs/OcrResult"
    },
    "extraction": {
      "$ref": "#/$defs/ExtractionResult"
    },
    "errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Errors",
      "type": "array"
    },
    "processing": {
      "additionalProperties": true,
      "title": "Processing",
      "type": "object"
    },
    "corrections": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Corrections",
      "type": "array"
    },
    "signatures": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignatureSection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "client_id",
    "document_id",
    "run_id",
    "source_sha256",
    "page_count",
    "processing_status",
    "ocr",
    "extraction",
    "errors",
    "processing"
  ],
  "title": "DocumentResult",
  "type": "object"
}
